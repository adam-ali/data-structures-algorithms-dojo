{
  "name": "dsa-dojo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kumon-style daily DSA practice: small problems, 5–10 tests each, levelled by topic, with a progress log.",
  "scripts": {
    "test": "vitest",
    "practice": "vitest --watch",
    "log": "tsx scripts/log.ts",
    "today": "tsx scripts/stats.ts",
    "stats": "tsx scripts/stats.ts --full",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
